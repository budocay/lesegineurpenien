		"gardien_archives": {"enemies": ["gardien_archives", "parchemin_vivant", "parchemin_vivant"], "arena": "archives", "music": "boss", "flee": false, "intro": "Le Gardien des Archives referme son registre. Les rayonnages, autour, se redressent pour mieux écouter."},
		"guetteur_du_lac": {"enemies": ["guetteur_lac", "tentacule_lac", "tentacule_lac"], "arena": "bord_du_lac", "music": "boss", "flee": false, "intro": "L'eau se creuse devant la porte. Quelque chose, dessous, a entendu qu'on avait la réponse."},
		"gobelins_du_camp": {"enemies": ["gobe_gras_camp", "gobe_gras_camp", "gobe_pic_camp", "gobe_pic_camp"], "arena": "galerie_mine", "music": "boss", "flee": false, "intro": "Le Gros Gobelardon repose sa louche. On n'interrompt pas un contremaître qui goûte."},
		"gros_bleu": {"enemies": ["gros_bleu", "gobe_lard", "gobe_lard"], "arena": "halle_piliers", "music": "boss", "flee": false, "intro": "Le Gros Bleu se détache de la paroi. Il avait la couleur du mur, ce qui expliquait la moisissure."},
		"goulum": {"enemies": ["goulum"], "arena": "bord_du_lac", "music": "boss", "flee": false, "intro": "Goulûm lâche son poisson. C'est mauvais signe : il n'a jamais rien lâché."},
		"balourd": {"enemies": ["balourd"], "arena": "pont_abime", "music": "morbier_pont", "flee": false, "intro": "Le Balourd se redresse, et le plafond change d'avis sur sa hauteur."},
		"ambuscade_chutes": {"enemies": ["uglouk", "ouroukouille_ligne", "ouroukouille_brocheur"], "arena": "chutes_gratin", "music": "boss", "flee": false, "intro": "Uglouk consulte un papier, lève la louche et dit : « Livraison. Veuillez signer ici. »"},
		"grimace": {"enemies": ["grimace", "corbeau_controleur", "corbeau_controleur"], "arena": "plaine_roquefort", "music": "boss", "flee": false, "intro": "Grimace ajuste sa toque. « Avant toute chose, rappelons le cadre. » Ce sera long."},
		"uglouk_garde": {"enemies": ["ouroukouille_ronde", "ouroukouille_ronde_brocheur", "paton"], "arena": "garde_manger", "music": "boss", "flee": false, "intro": "La ronde du Garde-Manger vous trouve hors de sa cage, ce qui n'est pas prévu à l'inventaire."},
		"froton_anneaute": {"enemies": ["froton_anneaute"], "arena": "garde_manger", "music": "boss", "flee": false, "intro": "Froton se redresse. Ses yeux ne sont plus tout à fait les siens : ils appartiennent à quelqu'un d'autre, qui a pris son temps pour s'installer."},
		"breche": {"enemies": ["ouroukouille_ligne", "ouroukouille_brocheur", "ouroukouille_petrisseur", "ouroukouille_petrisseur"], "arena": "petrins", "music": "boss", "flee": false, "intro": "Les fours rugissent. La brigade de nuit se met en rang, et la brigade de jour fait pareil, par politesse."},
		"sarumale": {"enemies": ["sarumale"], "arena": "terrasse_office", "music": "boss", "flee": false, "intro": "Sarumâle repose son stylo. « Bien. Reprenons le point un : vous. »"},
		"eveilles_1": {"enemies": ["eveille", "eveille", "eveille_veilleur"], "arena": "sentier_insomniaques", "intro": "Trois silhouettes se redressent dans leurs lits de pierre. Elles ont les yeux grands ouverts. Elles n'ont pas l'air de dormir depuis longtemps."},
		"eveilles_2": {"enemies": ["eveille_veilleur", "eveille", "eveille"], "arena": "sentier_insomniaques", "intro": "Une bougie s'allume. Puis quatre. Le Sentier se souvient qu'il est un dortoir."},
		"eveilles_3": {"enemies": ["eveille_veilleur", "eveille_veilleur", "eveille"], "arena": "sentier_insomniaques", "intro": "« Chut », disent trois voix. Puis plus rien, ce qui est pire."},
		"eveilles_4": {"enemies": ["eveille", "eveille_veilleur", "eveille"], "arena": "sentier_insomniaques", "intro": "Ils n'ont pas dormi depuis la bataille, ni depuis celle d'avant. Ils vous le font remarquer."},
		"roi_eveille": {"enemies": ["roi_eveille"], "arena": "sentier_insomniaques", "music": "boss", "flee": false, "boss": "roi_eveille", "intro": "Le Roi des Éveillés se redresse sur son estrade, sa bassinoire à la main. « Enfin, de la visite. Je n'ai pas fermé l'œil depuis la bataille des Champs du Pelle-à-Tarte. Il y a mille ans. »"},
		"saumure": {"enemies": ["saumure", "boucanier", "boucanier"], "arena": "port_sale", "music": "boss", "flee": false, "boss": "saumure", "intro": "Saumure tire son sabre, rajuste son tricorne et déclare, d'une voix de morue : « Au nom de l'Ombrine, je vous saisis ! Les marchandises, les passagers, et cette façon de me regarder. »"},
		"grondine": {"enemies": ["grondine", "morfale_siege"], "arena": "minas_remparts", "music": "boss", "flee": false, "boss": "grondine", "ramollissement": 0.3, "intro": "La Grondine avance. Elle est faite d'un chêne, de douze cerclages de fer, et d'une rancune. Elle ne parle pas. Elle gronde, et la porte lui répond en grinçant."},
		"gothmoque": {"enemies": ["gothmoque", "morfale_siege", "morfale_siege"], "arena": "minas_remparts", "music": "boss", "flee": false, "boss": "gothmoque", "ramollissement": 0.3, "intro": "Gothmoque descend de sa tour de bois, la massue sur l'épaule. « Rendez la ville. Ou rendez-moi l'argent de la poignée de porte. »"},
		"pelle_cassouletains": {"enemies": ["cassouletain", "cassouletain", "cassouletain", "cassouletain"], "arena": "pelle_a_tarte", "music": "bataille", "flee": false, "ramollissement": 0.3, "intro": "La cavalerie charge. Les Cassoulétains, une cassole sur la tête, la lance en avant, répondent par un chant de haricots."},
		"pelle_mammous": {"enemies": ["mammou", "cassouletain", "cassouletain"], "arena": "pelle_a_tarte", "music": "bataille", "flee": false, "ramollissement": 0.3, "intro": "Un barrissement, que l'on prend d'abord pour un cor. C'en est un, et c'est aussi un éléphant, qui porte une bannière faite d'une serviette."},
		"dindon_farce": {"enemies": ["dindon_farce", "cassouletain"], "arena": "pelle_a_tarte", "music": "boss", "flee": false, "boss": "dindon_farce", "ramollissement": 0.3, "intro": "Il s'avance, pas à pas, énorme, farci jusqu'au jabot. Le Dindon de la Farce. Autour de lui, le champ se tait, par respect pour ce qu'il a mangé."},
		"naze_supreme": {"enemies": ["naze_supreme"], "arena": "pelle_a_tarte", "music": "boss", "flee": false, "boss": "naze_supreme", "ramollissement": 0.3, "intro": "« Nul homme du Gouda ne peut me blesser », dit le Naze Suprême, d'une voix qui vient de dessous un capuchon vide. Il lève sa lame. Au bout de son doigt, un anneau minuscule brille."}
	},


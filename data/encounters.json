		"vacherin": {"enemies": ["vacherin", "ver_fromage", "ver_fromage"], "arena": "cave_fromage", "music": "boss", "flee": false, "intro": "Le Vacherin se déplie. Le plancher de la cave en profite pour se mettre à luire."},
		"chantecler": {"enemies": ["chantecler", "poussin_chantecler", "poussin_chantecler"], "arena": "ferme", "music": "boss", "flee": false, "intro": "Chantecler dresse la crête. Autour de lui, plus rien ne tient debout, sauf lui."},
		"nazes_nuit": {"enemies": ["naze_aine", "naze_cadet"], "arena": "etage_auberge", "music": "boss", "flee": false, "ramollissement": 0.3, "intro": "Deux Nazes, côte à côte, dans un couloir trop étroit. L'un frappe, l'autre souffle. Ils ne se sont pas parlé depuis cent ans, mais ils se complètent."},
		"duel_gaston": {"enemies": ["gaston_grosbras"], "arena": "place", "flee": false, "ramollissement": 0.5, "party": [{"id": "sam", "level": 9}], "inventory": {"tisane": 2}, "intro": "Le bras de fer commence. Il va durer, comme tout ce qui se fait mollement.", "hints": ["Ici, tout coup physique porte moins fort, pour les deux camps : il faudra de la patience. Sam peut se défendre pour souffler, ou boire une tisane."]},
		"duel_veuve": {"enemies": ["veuve_poignet"], "arena": "place", "flee": false, "ramollissement": 0.5, "party": [{"id": "sam", "level": 9}], "inventory": {"tisane": 3}, "intro": "La Veuve Poignet serre la main de Sam. Elle ne serre pas fort. Elle serre longtemps."},
		"prologue_sauron": {
			"enemies": ["sauron_vigueur"],
			"arena": "grand_four",
			"music": "boss",
			"flee": false,
			"intro": "Sauron, en pleine Vigueur, barre l'accès au Grand Four.",
			"party": [{"id": "glandoulf", "level": 20}, {"id": "isidur", "level": 20}],
			"inventory": {"tisane": 3, "cidre": 2, "racine": 1},
			"hints": [
				"Chacun agit à son tour, selon sa vitesse : l'ordre est affiché en haut à gauche. Choisissez « Attaquer » avec {interact}.",
				"Les cases sous l'ennemi sont ses faiblesses, d'abord inconnues. Sauron craint le tranchant : l'épée d'Isidur fait mouche.",
				"Chaque coup sur une faiblesse entame le bouclier (le chiffre). À zéro, l'ennemi est Ébranlé : il passe son tour et encaisse davantage.",
				"Les compétences coûtent du mana (PM). Essayez « Bâillement contagieux » : Sauron ne dort jamais, la torpeur lui fait très mal.",
				"« Objets » : une tisane rend des PV, une chope de cidre du mana. « Défendre » réduit les dégâts de moitié et rend un peu de mana.",
				"{cancel} annule un choix. Quand la vie de Sauron tombe à zéro, c'est gagné."
			]
		},
